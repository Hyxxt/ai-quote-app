# OpenAI 兼容接口：DeepSeek 用 https://api.deepseek.com/v1，OpenAI 用 https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 设为 1 时强制使用内置规则解析（无 Key 演示用；留空则先尝试大模型）
USE_RULE_EXTRACTOR=0

# 线上云数据库（部署到 Vercel 等无持久磁盘环境时填写；本地留空则用 .data/quotes.db）
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# 本地 SQLite 文件目录，默认项目下的 .data
# QUOTE_DB_DIR=
